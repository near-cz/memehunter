# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# X API v2 (recent-search access required)
X_API_BEARER_TOKEN=
X_SEARCH_QUERY=(memecoin OR "meme coin" OR "fair launch") lang:en -is:retweet

# Scanner
POLL_INTERVAL_SECONDS=180
MIN_OPPORTUNITY_SCORE=45
DATABASE_PATH=data/memehunter.sqlite3

# Local read-only API and dashboard
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Application
APP_ENV=development
LOG_LEVEL=info

# Solana public RPC endpoint only; no private key or seed phrase belongs here.
SOLANA_RPC_URL=
