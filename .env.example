# Default: combine both public on-chain sources (no API key)
SOURCE_MODE=both
MAX_TOKENS_PER_CYCLE=12
MAX_DAILY_LAUNCHES=5
POLL_INTERVAL_SECONDS=180
MIN_OPPORTUNITY_SCORE=45
DATABASE_PATH=data/memehunter.sqlite3

# Free public social discovery (no account or API key)
BLUESKY_SEARCH_QUERY=meme OR memecoin OR viral OR trending

# X is disabled by default; enabling it may incur usage charges
ENABLE_X_API=false
X_API_BEARER_TOKEN=
X_SEARCH_QUERY=(meme OR viral OR trending OR funny OR community) lang:en -is:retweet -is:reply

# Optional Telegram alerts; leave both blank to disable
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Dashboard HTTP Basic Auth (set a strong password locally; never commit .env)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
