# Default: combine both public on-chain sources (no API key)
SOURCE_MODE=both
MAX_TOKENS_PER_CYCLE=12
MAX_DAILY_LAUNCHES=5
POLL_INTERVAL_SECONDS=180
MIN_OPPORTUNITY_SCORE=45
DATABASE_PATH=data/memehunter.sqlite3

# Optional X integration (requires X Developer API access; scanner pauses X if token is blank)
X_API_BEARER_TOKEN=
X_SEARCH_QUERY=(memecoin OR meme coin OR "fair launch") lang:en -is:retweet

# Optional Telegram alerts; leave both blank to disable
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Dashboard HTTP Basic Auth (set a strong password locally; never commit .env)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
